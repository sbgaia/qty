  "MagneticFlux.Weber = ElectricInductance.Henry * ElectricCurrent.Ampere",
  "MagneticFlux.Weber = ElectricPotential.Volt * Duration.Second",
  "ThermalConductivity.WattPerMeterKelvin = HeatTransferCoefficient.WattPerSquareMeterKelvin * Length.Meter"
